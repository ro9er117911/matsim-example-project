<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
    <module name="PublicTransitMapping" >
        <!-- Path to the input network file. -->
        <param name="inputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/01_raw_data/combined_network_clean.xml.gz" />
        <!-- Path to the input schedule file. -->
        <param name="inputScheduleFile" value="/Users/ro9air/matsim-example-project/5000_disatar/01_raw_data/transitSchedule.xml" />
        
        <param name="candidateDistanceMultiplier" value="1.6" />
        <param name="maxLinkCandidateDistance" value="600.0" />
        <param name="maxTravelCostFactor" value="30.0" />
        <param name="modeSpecificRules" value="true" />
        <param name="modesToKeepOnCleanUp" value="car" />
        <param name="nLinkThreshold" value="15" />
        <param name="networkRouter" value="AStarLandmarks" />
        <param name="numOfThreads" value="4" />
        
        <param name="outputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/01_raw_data/combined_network_pt.xml.gz" />
        <param name="outputScheduleFile" value="/Users/ro9air/matsim-example-project/5000_disatar/01_raw_data/transitSchedule_mapped.xml.gz" />
        <param name="outputStreetNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/01_raw_data/street_network.xml.gz" />

        <param name="removeNotUsedStopFacilities" value="true" />
        <param name="routingWithCandidateDistance" value="true" />
        <param name="scheduleFreespeedModes" value="artificial" />
        <param name="threadChunkSize" value="100" />
        <param name="travelCostType" value="linkLength" />

        <!-- Scientific Parameters for Metro (MRT) -->
        <parameterset type="transportModeAssignment" >
            <param name="maxLinkCandidateDistance" value="300.0" />
            <param name="nLinkThreshold" value="12" />
            <param name="networkModes" value="rail,light_rail,subway" />
            <param name="scheduleMode" value="subway" />
            <param name="strictLinkRule" value="true" />
        </parameterset>

        <!-- Scientific Parameters for Bus -->
        <parameterset type="transportModeAssignment" >
            <param name="maxLinkCandidateDistance" value="600.0" />
            <param name="nLinkThreshold" value="15" />
            <param name="networkModes" value="car,bus" />
            <param name="scheduleMode" value="bus" />
            <param name="strictLinkRule" value="false" />
        </parameterset>
    </module>
</config>
