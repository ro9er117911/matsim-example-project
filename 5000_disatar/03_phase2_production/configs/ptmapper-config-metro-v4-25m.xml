<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<module name="PublicTransitMapping" >
		<!-- Metro-only mapping on ultra-detailed 25m network -->

		<!-- Aggressive artificial linking to ensure coverage -->
		<param name="candidateDistanceMultiplier" value="5.0" />

		<param name="inputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/03_phase2_production/networks/network_v4_25m.xml" />
		<param name="inputScheduleFile" value="/Users/ro9air/matsim-example-project/5000_disatar/02_phase1_test/schedules/metro/transitSchedule.xml" />

		<param name="maxLinkCandidateDistance" value="3000.0" />
		<param name="maxTravelCostFactor" value="50.0" />
		<param name="modeSpecificRules" value="true" />
		<param name="modesToKeepOnCleanUp" value="car" />
		<param name="nLinkThreshold" value="10" />
		<param name="networkRouter" value="SpeedyALT" />
		<param name="numOfThreads" value="8" />

		<param name="outputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/03_phase2_production/networks/network-with-pt-metro-v4-25m.xml" />
		<param name="outputScheduleFile" value="/Users/ro9air/matsim-example-project/5000_disatar/03_phase2_production/schedules/metro/transitSchedule-mapped-metro-v4-25m.xml.gz" />
		<param name="outputStreetNetworkFile" value="" />

		<param name="removeNotUsedStopFacilities" value="true" />
		<param name="routingWithCandidateDistance" value="true" />
		<param name="scheduleFreespeedModes" value="artificial" />
		<param name="threadChunkSize" value="100" />
		<param name="travelCostType" value="linkLength" />

		<!-- Rail-ish modes for metro; allow pt to leverage road network -->
		<parameterset type="transportModeAssignment" >
			<param name="maxLinkCandidateDistance" value="3000.0" />
			<param name="nLinkThreshold" value="10" />
			<param name="networkModes" value="car,rail,light_rail,pt" />
			<param name="scheduleMode" value="rail" />
			<param name="strictLinkRule" value="false" />
		</parameterset>

		<parameterset type="transportModeAssignment" >
			<param name="maxLinkCandidateDistance" value="3000.0" />
			<param name="nLinkThreshold" value="10" />
			<param name="networkModes" value="car,pt" />
			<param name="scheduleMode" value="subway" />
			<param name="strictLinkRule" value="false" />
		</parameterset>
	</module>
</config>
