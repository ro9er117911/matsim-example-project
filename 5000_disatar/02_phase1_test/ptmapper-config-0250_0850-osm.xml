<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
  <module name="PublicTransitMapping">
    <param name="inputNetworkFile" value="5000_disatar/02_phase1_test/networks/network_osm_multimodal_0250_0850_clean_pt.xml.gz" />
    <param name="inputScheduleFile" value="5000_disatar/02_phase1_test/pt2matsim_0250_0850_osm/transitSchedule.xml" />
    <param name="outputNetworkFile" value="5000_disatar/02_phase1_test/pt2matsim_0250_0850_osm/network-with-pt.xml.gz" />
    <param name="outputScheduleFile" value="5000_disatar/02_phase1_test/pt2matsim_0250_0850_osm/transitSchedule-mapped.xml.gz" />

    <param name="candidateDistanceMultiplier" value="3.0" />
    <param name="maxLinkCandidateDistance" value="300.0" />
    <param name="nLinkThreshold" value="12" />
    <param name="maxTravelCostFactor" value="15.0" />

    <param name="networkRouter" value="AStarLandmarks" />
    <param name="numOfThreads" value="4" />
    <param name="modeSpecificRules" value="true" />
    <param name="routingWithCandidateDistance" value="true" />
    <param name="modesToKeepOnCleanUp" value="car,bus,subway,walk" />

    <parameterset type="transportModeAssignment" >
      <param name="scheduleMode" value="bus" />
      <param name="networkModes" value="bus" />
      <param name="maxLinkCandidateDistance" value="300.0" />
      <param name="nLinkThreshold" value="12" />
      <param name="strictLinkRule" value="false" />
    </parameterset>

    <parameterset type="transportModeAssignment" >
      <param name="scheduleMode" value="subway" />
      <param name="networkModes" value="subway" />
      <param name="maxLinkCandidateDistance" value="0.0" />
      <param name="nLinkThreshold" value="1" />
      <param name="strictLinkRule" value="false" />
    </parameterset>
  </module>
</config>
