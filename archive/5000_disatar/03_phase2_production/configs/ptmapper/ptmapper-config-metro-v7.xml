<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<module name="PublicTransitMapping" >
		<!-- Metro-only mapping onto car+walk network_v7 -->

		<param name="candidateDistanceMultiplier" value="3.0" />
		<param name="inputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/03_phase2_production/networks/network_v7_car_walk_clean.xml.gz" />
		<param name="inputScheduleFile" value="/Users/ro9air/matsim-example-project/5000_disatar/02_phase1_test/schedules/metro/transitSchedule.xml" />

		<param name="maxLinkCandidateDistance" value="1500.0" />
