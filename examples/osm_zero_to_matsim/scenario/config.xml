<?xml version="1.0"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
<!-- 預設config模板在 [defaultConfig.xml] github路徑：[https://github.com/ro9er117911/matsim-example-project/blob/main/defaultConfig.xml]-->
  <module name="global">
    <param name="randomSeed" value="4711" />
    <!-- 本 repo 預設座標系：台灣 TWD97 / TM2 zone 121 -->
    <param name="coordinateSystem" value="EPSG:3826" />
  </module>
<!--預設network模型，設定輸入網絡為input/network.xml.gz-->
  <module name="network">
    <param name="inputNetworkFile" value="input/network.xml.gz" />
  </module>
<!--預設plans模型，設定輸入計劃為input/population.xml.gz-->
  <module name="plans">
    <param name="inputPlansFile" value="input/population.xml.gz" />
    <param name="handlingOfPlansWithoutRoutingMode" value="reject" />
  </module>
<!--預設controller模型，設定輸出目錄為output，設定最後迭代為5，設定覆寫文件為deleteDirectoryIfExists，設定寫入事件間隔為1-->
  <module name="controller">
    <param name="outputDirectory" value="output" />
    <param name="lastIteration" value="5" />
    <param name="overwriteFiles" value="deleteDirectoryIfExists" />
    <param name="writeEventsInterval" value="1" />
  </module>
<!--預設queue模型，設定主模式為汽車，設定汽車的車輛來源為預設車輛，設定流量容量因子為1，設定存儲容量因子為1，設定卡車時間為10，設定移除卡車為false，設定開始時間為00:00:00，設定結束時間為30:00:00-->
  <module name="qsim">
    <param name="mainMode" value="car" />
    <param name="vehiclesSource" value="defaultVehicle" />
    <param name="flowCapacityFactor" value="1.0" />
    <param name="storageCapacityFactor" value="1.0" />
    <param name="stuckTime" value="10.0" />
    <param name="removeStuckVehicles" value="false" />
    <param name="startTime" value="00:00:00" />
    <param name="endTime" value="30:00:00" />
  </module>

  <module name="routing">
    <param name="networkModes" value="car" />
  </module>
    <!--預設replanning模型，新的迭代會進入兩種策略其中一種（80%/20%），ChangeExpBeta是權重選擇不同plan，ReRoute為重新路徑演算法（創新算法）-->
  <module name="replanning">
    <param name="maxAgentPlanMemorySize" value="5" />
    <parameterset type="strategysettings">
      <param name="strategyName" value="ChangeExpBeta" />
      <param name="weight" value="0.8" />
    </parameterset>
    <parameterset type="strategysettings">
      <param name="strategyName" value="ReRoute" />
      <param name="weight" value="0.2" />
    </parameterset>
  </module>

<!--預設scoring模型，設定邊際效用為1，設定汽車的效用預設參數（旅行時間的直接邊際效用，效用越低表示越不樂意步行）-->
  <module name="scoring">
    <parameterset type="scoringParameters">
      <param name="marginalUtilityOfMoney" value="1.0" />

      <!-- 定義汽車的效用預設參數（旅行時間的直接邊際效用，效用越低表示越不樂意步行） -->
      <parameterset type="modeParams">
        <param name="mode" value="car" />
        <param name="constant" value="0.0" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
      </parameterset>
      <!-- MATSim 2025 內部會用到 pt 的 modeParams（例如 waitingPt 的衍生參數），即使你是 car-only -->
      <parameterset type="modeParams">
        <param name="mode" value="pt" />
        <param name="constant" value="0.0" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
      </parameterset>
      <!-- 定義步行的「效用」預設參數（旅行時間的直接邊際效用，效用越低表示越不樂意步行） -->
      <parameterset type="modeParams">
        <param name="mode" value="walk" />
        <param name="constant" value="0.0" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0" />
      </parameterset>
      <!-- 定義活動的典型「停留時間」 -->
      <parameterset type="activityParams">
        <param name="activityType" value="home" />
        <param name="typicalDuration" value="12:00:00" />
      </parameterset>
      <parameterset type="activityParams">
        <param name="activityType" value="work" />
        <param name="typicalDuration" value="08:00:00" />
      </parameterset>
    </parameterset>
  </module>

</config>



