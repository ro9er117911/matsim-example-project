<?xml version="1.0"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

  <module name="global">
    <param name="randomSeed" value="4711" />
    <param name="coordinateSystem" value="EPSG:3826" />
    <param name="numberOfThreads" value="4" />
  </module>

  <module name="network">
    <param name="inputNetworkFile" value="network-with-pt-car-connected.xml.gz" />
  </module>

  <module name="plans">
    <param name="inputPlansFile" value="population_tamsui_100.xml" />
    <param name="handlingOfPlansWithoutRoutingMode" value="reject" />
  </module>

  <module name="transit">
    <param name="useTransit" value="true" />
    <param name="transitScheduleFile" value="transitSchedule.xml.gz" />
    <param name="vehiclesFile" value="transitVehicles.xml.gz" />
    <param name="transitModes" value="pt" />
    <param name="usingTransitInMobsim" value="true" />
  </module>

  <module name="controller">
    <param name="outputDirectory" value="5000_disatar/06_preference_tests/pt_0250_0850/output_tamsui_100" />
    <param name="lastIteration" value="0" />
    <param name="writeEventsInterval" value="1" />
    <param name="overwriteFiles" value="deleteDirectoryIfExists" />
  </module>

  <module name="qsim">
    <param name="mainMode" value="car" />
    <param name="vehiclesSource" value="defaultVehicle" />
    <param name="linkDynamics" value="PassingQ" />
    <param name="flowCapacityFactor" value="1.0" />
    <param name="storageCapacityFactor" value="1.0" />
    <param name="simStarttimeInterpretation" value="onlyUseStarttime" />
    <param name="startTime" value="00:00:00" />
    <param name="endTime" value="12:00:00" />
    <param name="stuckTime" value="120.0" />
    <param name="removeStuckVehicles" value="false" />
  </module>

  <module name="routing">
    <param name="networkModes" value="car" />
    <param name="accessEgressType" value="accessEgressModeToLink" />
    <param name="clearDefaultTeleportedModeParams" value="true" />
    <parameterset type="teleportedModeParameters">
      <param name="mode" value="walk" />
      <param name="teleportedModeSpeed" value="1.388888888" />
      <param name="beelineDistanceFactor" value="1.3" />
    </parameterset>
    <parameterset type="teleportedModeParameters">
      <param name="mode" value="access_walk" />
      <param name="teleportedModeSpeed" value="1.388888888" />
      <param name="beelineDistanceFactor" value="1.3" />
    </parameterset>
    <parameterset type="teleportedModeParameters">
      <param name="mode" value="egress_walk" />
      <param name="teleportedModeSpeed" value="1.388888888" />
      <param name="beelineDistanceFactor" value="1.3" />
    </parameterset>
    <parameterset type="teleportedModeParameters">
      <param name="mode" value="transit_walk" />
      <param name="teleportedModeSpeed" value="1.388888888" />
      <param name="beelineDistanceFactor" value="1.3" />
    </parameterset>
  </module>

  <module name="swissRailRaptor">
    <param name="useIntermodalAccessEgress" value="false" />
    <param name="transferPenaltyBaseCost" value="0.0" />
    <param name="transferPenaltyCostPerTravelTimeHour" value="0.0" />
    <param name="useModeMappingForPassengers" value="false" />
  </module>

  <module name="transitRouter">
    <param name="additionalTransferTime" value="120.0" />
    <param name="directWalkFactor" value="1000.0" />
    <param name="maxBeelineWalkConnectionDistance" value="200.0" />
    <param name="searchRadius" value="500.0" />
  </module>

  <module name="scoring">
    <param name="lateArrival" value="-18" />
    <param name="performing" value="+6" />
    <parameterset type="scoringParameters">
      <parameterset type="modeParams">
        <param name="mode" value="car" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="pt" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="walk" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="access_walk" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="egress_walk" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="transit_walk" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0" />
      </parameterset>
      <parameterset type="activityParams">
        <param name="activityType" value="home" />
        <param name="typicalDuration" value="04:00:00" />
      </parameterset>
      <parameterset type="activityParams">
        <param name="activityType" value="work" />
        <param name="typicalDuration" value="04:00:00" />
      </parameterset>
    </parameterset>
  </module>

</config>
