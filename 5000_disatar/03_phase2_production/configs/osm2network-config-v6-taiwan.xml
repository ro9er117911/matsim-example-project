<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<module name="global">
		<param name="coordinateSystem" value="EPSG:3826"/>
		<param name="numberOfThreads" value="8"/>
	</module>

	<module name="OsmConverter">
		<!-- Taiwan extract clipped to Taipei bbox+buffer (includes alleys/paths) -->
		<param name="osmFile" value="/Users/ro9air/matsim-example-project/5000_disatar/01_raw_data/osm/taiwan_latest.osm.pbf"/>

		<!-- Output coordinate system (TWD97) -->
		<param name="outputCoordinateSystem" value="EPSG:3826"/>

		<!-- High-detail raw network (no cleaner) -->
		<param name="outputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/03_phase2_production/networks/network_taiwan_full_raw.xml"/>

		<!-- Keep fine-grained links and tags for debugging -->
		<param name="keepPaths" value="true"/>
		<param name="keepWaysWithPublicTransit" value="true"/>
		<param name="keepTagsAsAttributes" value="true"/>

		<!-- Short segments to retain local streets/alleys -->
		<param name="maxLinkLength" value="75.0"/>

		<!-- Scale speeds based on OSM defaults -->
		<param name="scaleMaxSpeed" value="true"/>
	</module>
</config>
