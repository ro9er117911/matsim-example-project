<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

	<module name="global">
		<param name="coordinateSystem" value="EPSG:3826"/>
		<param name="numberOfThreads" value="4"/>
		<param name="randomSeed" value="4711"/>
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="network-with-pt.xml"/>
	</module>

	<module name="plans">
		<param name="handlingOfPlansWithoutRoutingMode" value="useMainModeIdentifier"/>
		<param name="inputPlansFile" value="population_test_10agents.xml"/>
	</module>

	<module name="controller">
		<param name="firstIteration" value="0"/>
		<param name="lastIteration" value="10"/>
		<param name="outputDirectory" value="./output_test_10agents"/>
		<param name="overwriteFiles" value="deleteDirectoryIfExists"/>
		<param name="writeEventsInterval" value="10"/>
		<param name="writePlansInterval" value="10"/>
	</module>

	<module name="qsim">
		<param name="startTime" value="00:00:00"/>
		<param name="endTime" value="30:00:00"/>
		<param name="flowCapacityFactor" value="1.0"/>
		<param name="storageCapacityFactor" value="1.0"/>
		<param name="numberOfThreads" value="4"/>
		<param name="snapshotperiod" value="00:00:00"/>
		<param name="mainMode" value="car"/>
		<param name="linkDynamics" value="PassingQ"/>
		<param name="trafficDynamics" value="queue"/>
		<param name="vehiclesSource" value="defaultVehicle"/>
	</module>

	<!-- PT Configuration -->
	<module name="transit">
		<param name="useTransit" value="true"/>
		<param name="usingTransitInMobsim" value="true"/>
		<param name="routingAlgorithmType" value="SwissRailRaptor"/>
		<param name="transitScheduleFile" value="transitSchedule-mapped.xml.gz"/>
		<param name="vehiclesFile" value="merged/transitVehicles.xml"/>
		<param name="transitModes" value="pt"/>
	</module>

	<!-- SwissRailRaptor for PT routing -->
	<module name="transitRouter">
		<param name="extensionRadius" value="500.0"/>
		<param name="maxBeelineWalkConnectionDistance" value="300.0"/>
		<param name="searchRadius" value="1500.0"/>
	</module>

	<module name="swissRailRaptor">
		<param name="useIntermodalAccessEgress" value="false"/>
		<param name="transferPenaltyBaseCost" value="0.0"/>
		<param name="transferPenaltyCostPerTravelTimeHour" value="0.0"/>
		<param name="transferPenaltyMinCost" value="0.0"/>
		<param name="transferPenaltyMaxCost" value="Infinity"/>
		<param name="useModeMappingForPassengers" value="false"/>
	</module>

	<!-- Routing configuration -->
	<module name="routing">
		<param name="networkModes" value="car"/>
		<param name="networkRouteConsistencyCheck" value="disable"/>
		<param name="accessEgressType" value="accessEgressModeToLink"/>

		<!-- Walk mode (teleported) -->
		<parameterset type="teleportedModeParameters">
			<param name="mode" value="walk"/>
			<param name="teleportedModeSpeed" value="1.388888888"/>
			<param name="beelineDistanceFactor" value="1.3"/>
		</parameterset>

		<!-- Bike mode (teleported) -->
		<parameterset type="teleportedModeParameters">
			<param name="mode" value="bike"/>
			<param name="teleportedModeSpeed" value="4.166666667"/>
			<param name="beelineDistanceFactor" value="1.3"/>
		</parameterset>
	</module>

	<!-- Scoring parameters -->
	<module name="scoring">
		<param name="fractionOfIterationsToStartScoreMSA" value="0.8"/>
		<param name="BrainExpBeta" value="1.0"/>

		<!-- Mode-specific constants -->
		<parameterset type="modeParams">
			<param name="constant" value="0.0"/>
			<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
			<param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
			<param name="mode" value="car"/>
			<param name="monetaryDistanceRate" value="-0.0002"/>
		</parameterset>

		<parameterset type="modeParams">
			<param name="constant" value="-0.0"/>
			<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
			<param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
			<param name="mode" value="pt"/>
			<param name="monetaryDistanceRate" value="0.0"/>
		</parameterset>

		<parameterset type="modeParams">
			<param name="constant" value="0.0"/>
			<param name="marginalUtilityOfDistance_util_m" value="0.0"/>
			<param name="marginalUtilityOfTraveling_util_hr" value="0.0"/>
			<param name="mode" value="walk"/>
		</parameterset>

		<!-- Activity types -->
		<parameterset type="activityParams">
			<param name="activityType" value="home"/>
			<param name="typicalDuration" value="12:00:00"/>
		</parameterset>

		<parameterset type="activityParams">
			<param name="activityType" value="work"/>
			<param name="typicalDuration" value="08:00:00"/>
			<param name="openingTime" value="06:00:00"/>
			<param name="closingTime" value="20:00:00"/>
		</parameterset>

		<parameterset type="activityParams">
			<param name="activityType" value="pt_interaction"/>
			<param name="typicalDuration" value="00:00:01"/>
			<param name="scoringThisActivityAtAll" value="false"/>
		</parameterset>
	</module>

	<!-- Strategy configuration -->
	<module name="replanning">
		<param name="fractionOfIterationsToDisableInnovation" value="0.8"/>

		<parameterset type="strategysettings">
			<param name="strategyName" value="ChangeExpBeta"/>
			<param name="weight" value="0.8"/>
		</parameterset>

		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="weight" value="0.1"/>
		</parameterset>

		<parameterset type="strategysettings">
			<param name="strategyName" value="SubtourModeChoice"/>
			<param name="weight" value="0.1"/>
		</parameterset>
	</module>

	<module name="subtourModeChoice">
		<param name="chainBasedModes" value="bike"/>
		<param name="modes" value="pt,walk"/>
		<param name="considerCarAvailability" value="true"/>
		<param name="behavior" value="fromAllModesToSpecifiedModes"/>
	</module>

	<!-- Vehicles -->
	<module name="vehicles">
		<param name="vehiclesFile" value="null"/>
	</module>

</config>
