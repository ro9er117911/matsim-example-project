		<param name="modesToKeepOnCleanUp" value="car,walk" />
		<param name="nLinkThreshold" value="12" />
		<param name="networkRouter" value="AStarLandmarks" />
		<param name="numOfThreads" value="8" />

		<param name="outputNetworkFile" value="/Users/ro9air/matsim-example-project/5000_disatar/03_phase2_production/networks/network-with-pt-metro-v7.xml" />
